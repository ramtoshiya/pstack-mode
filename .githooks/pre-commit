#!/bin/sh
set -e
cd "$(git rev-parse --show-toplevel)"
stray=$(git ls-files | cut -d/ -f1 | sort -u |
  grep -vxE 'upstream|plugins|mode|scripts|tests|docs|\.githooks|\.claude-plugin|README\.md|\.gitignore' || true)
if [ -n "$stray" ]; then
  echo "Unexpected top-level paths: $(echo $stray). Mirror files belong under upstream/: merge with -Xsubtree=upstream as docs/build-mode.md describes." >&2
  exit 1
fi
if ! git diff --cached --quiet -- upstream &&
   ! git log --format=%T refs/remotes/upstream/main 2>/dev/null | grep -qx "$(git write-tree --prefix=upstream/)"; then
  echo "upstream/ must match a backnotprop/pstack mirror commit byte for byte. Adapt text for this package in TRANSFORMS in scripts/build-mode.py, or merge from the mirror as docs/build-mode.md describes." >&2
  exit 1
fi
python3 scripts/build-mode.py --check
python3 -m unittest discover -s tests -q
